{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext", "DOM"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "skipLibCheck": false,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedSideEffectImports": true,
    "exactOptionalPropertyTypes": true
  },
  "include": ["src/*.ts"]
}
